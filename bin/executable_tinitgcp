#!/usr/bin/env bash

set -u

debug=0
if [[ ${1:-} = -d ]]; then
    debug=1
    set -x
    shift
fi

invocation_dir=$PWD
git_project_dir="$(git rev-parse --show-toplevel 2>/dev/null || true)"

if [[ -n $git_project_dir ]]; then
    search_root=$git_project_dir
else
    search_root=$HOME
fi

folder_name="$(basename "$invocation_dir")"
export folder_name

project_config=
config_search_dir=$invocation_dir
while :; do
    if [[ -r "$config_search_dir/.tinitgcp" ]]; then
        project_config="$config_search_dir/.tinitgcp"
        break
    fi

    if [[ "$config_search_dir" = "$search_root" ]]; then
        break
    fi

    config_search_dir=$(dirname "$config_search_dir")
done

if [[ -n $project_config ]]; then
    config_dir=$(dirname "$project_config")
else
    config_dir=$invocation_dir
fi

if [[ $# -eq 1 ]]; then
    if [[ -z $project_config ]]; then
        echo "Project config '.tinitgcp' not found between '$invocation_dir' and '$search_root'" >&2
        exit 2
    fi

    env=$1
    declare -A state_location=()
    # shellcheck source=/dev/null
    . "$project_config"

    if [[ -z ${state_location[$env]:-} ]]; then
        known_envs=("${!state_location[@]}")
        printf 'Unknown environment %q (known: %s)\n' "$env" "$(IFS=', '; echo "${known_envs[*]}")" >&2
        exit 5
    fi
    state_path=${state_location[$env]}
elif [[ $# -eq 2 ]]; then
    env=$2
    if [[ -n $project_config ]]; then
        echo "Error: this project has a .tinitgcp file but common state argument '${env}' given" >&2
        exit 3
    fi
    state_path="$1"
else
    echo "Usage: tinitgcp [-d] [BUCKET/PREFIX] ENVIRONMENT" >&2
    exit 4
fi

if [[ $state_path != */* ]]; then
    echo "Invalid state path '$state_path': expected 'bucket/prefix'" >&2
    exit 6
fi

env_vars_file="${config_dir}/environments/${env}.tfvars"

if [[ ! -f "$env_vars_file" ]]; then
    echo "Warning: environment vars file '${env_vars_file}' not found" >&2
fi

bucket=${state_path%%/*}
base_prefix=${state_path#*/}

terraform init -reconfigure -backend-config="bucket=$bucket" -backend-config="prefix=$base_prefix"
rc=$?

if [[ $debug -eq 0 ]]; then
    set +x
fi

exit "$rc"
