[user]
        name = Matthew Topping
        email = a-matthew.topping@mtopps.com
[log]
        showSignature = true
[alias]
        co = checkout
        br = branch
        ci = commit
        st = status
        adog = log --all --decorate --oneline --graph --no-show-signature
[credential]
        helper = cache --timeout=3600
[advice]
        detachedHead = false
[init]
        defaultBranch = main
[pull]
        rebase = true
[push]
        default = current