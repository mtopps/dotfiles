{
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "breadcrumbs.enabled": false,
  "cursor.chat.terminalShowHoverHint": false,
  "cursor.cmdk.useThemedDiffBackground": true,
  "cursor.general.enableShadowWorkspace": true,
  "cursor.general.gitGraphIndexing": "enabled",
  "editor.fontFamily": "'Hack Nerd Font', 'monospace'",
  "editor.fontSize": 14,
  "editor.stickyScroll.enabled": false,
  "editor.suggest.preview": true,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "files.autoSave": "afterDelay",
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "never",
  "terminal.explorerKind": "external",
  "terminal.external.osxExec": "Ghostty.app",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.enableImages": true,
  "terminal.integrated.fontFamily": "Hack Nerd Font, monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.scrollback": 10000000,
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.useWslProfiles": false,
  "terraform.experimentalFeatures.validateOnSave": true,
  "terraform.languageServer.ignoreSingleFileWarning": true,
  "window.newWindowDimensions": "inherit",
  "window.newWindowProfile": "Default",
  "workbench.activityBar.location": "default",
  "workbench.activityBar.orientation": "vertical",
  "workbench.editor.enablePreview": false,
  "workbench.preferredDarkColorTheme": "Monokai Dimmed",
  "workbench.tips.enabled": true,
  "chat.commandCenter.enabled": false,
  "window.commandCenter": true,
  "redhat.telemetry.enabled": false,
  "workbench.productIconTheme": "material-product-icons",
  "cursor.composer.shouldAllowCustomModes": true,
  "update.releaseTrack": "prerelease",
  "workbench.colorTheme": "GitHub Dark Default",
  "ansible.lightspeed.enabled": false,
  "ansible.lightspeed.suggestions.enabled": false,
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "cursor.diffs.useCharacterLevelDiffs": true,
  "git.suggestSmartCommit": false,
  "workbench.iconTheme": "material-icon-theme",
  "files.associations": {
    "*.j2": "ansible-jinja"
  },
  "remote.SSH.remotePlatform": {
    "pve01": "linux"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "cursor.semanticSearch.includePullRequests": false,
  "cursor.cpp.disabledLanguages": [
    "plaintext"
  ],
  "openscad.launchPath": "/Applications/OpenSCAD-2021.01.app/Contents/MacOS/OpenSCAD"
}
