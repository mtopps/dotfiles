{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.hostname "nimbus") -}}
[user]
  name = {{ .name }}
  email = {{ .work_email }}
  signingkey = {{ onepasswordRead "op://sshkeys/Git signing work/public key" }}

[gpg]
  format = ssh

[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[commit]
  gpgsign = true

[log]
  showSignature = true

[alias]
  co = checkout
  br = branch
  ci = commit
  st = status
  adog = log --all --decorate --oneline --graph --no-show-signature

[credential]
  helper = cache --timeout=3600

[advice]
  detachedHead = false

[init]
  defaultBranch = main

[pull]
  rebase = true

[push]
  default = current
{{- end }}
