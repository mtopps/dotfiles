[core]
  editor = vim
  excludesfile = ~/.gitignore_global

[user]
  email = matthewatopping@gmail.com
  name = Matthew Topping
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ1AC6C4tbxCQmbjnfZjfXx8tuZj4KaWr11qrKVHuntU

[gpg]
  format = ssh

[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[commit]
  gpgsign = true

[log]
  showSignature = true

[alias]
  co = checkout
  br = branch
  ci = commit --message
  st = status
  sw = switch
  adog = log --all --decorate --oneline --graph --no-show-signature

[credential]
  helper = cache --timeout=3600

[advice]
  detachedHead = false

[init]
  defaultBranch = main

[pull]
  rebase = true

[push]
  default = current


