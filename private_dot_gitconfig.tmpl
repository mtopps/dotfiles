{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.hostname "nimbus") -}}
[core]
  editor = vim
  excludesfile = ~/.gitignore_global

[user]
  email = {{ .email }}
  name = {{ .name }}
  signingkey = {{ onepasswordRead "op://sshkeys/Git signing personal/public key" }}

[gpg]
  format = ssh

[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[commit]
  gpgsign = true

[includeIf "gitdir:~/code/terraform/azure"]
  path = ~/.gitconfig_ado

[log]
  showSignature = true

[alias]
  co = checkout
  br = branch
  ci = commit --message
  st = status
  sw = switch
  adog = log --all --decorate --oneline --graph --no-show-signature

[credential]
  helper = cache --timeout=3600

[advice]
  detachedHead = false

[init]
  defaultBranch = main

[pull]
  rebase = true

[push]
  default = current
{{ end }}
