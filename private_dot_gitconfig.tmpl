[core]
editor = vim
excludesfile = ~/.gitignore_global

[user]
email = {{ .email }}
name = {{ .name }}

[includeIf "gitdir:~/code/azure-devops/"]
path = ~/.gitconfig_ado_personal

[log]
showSignature = true

[alias]
co = checkout
br = branch
ci = commit --message
st = status
sw = switch
adog = log --all --decorate --oneline --graph --no-show-signature

[credential]
helper = cache --timeout=3600

[advice]
detachedHead = false

[init]
defaultBranch = main

[pull]
rebase = true

[push]
default = current
